<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CaffeineWin</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <Version>2.0.0</Version>
    <Product>Caffeine</Product>
    <Authors>Somesh Kumar</Authors>
    <Copyright>Copyright (c) 2026 Somesh Kumar</Copyright>
    <Description>A Windows tray app that keeps your screen awake, and keeps your focus, notes and tasks with it.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kumarsomeshunos/caffeine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kumarsomeshunos/caffeine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
