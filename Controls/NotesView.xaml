<UserControl x:Class="CaffeineWin.Controls.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CaffeineWin.Controls">

    <!-- The whole notes experience, hosted either as a panel inside the tray window or inside
         NotesWindow. Exactly one instance exists (App owns it) and it is reparented between the
         two, so there is never more than one store over notes.json. -->
    <UserControl.Resources>
        <CubicEase x:Key="BubbleEase" EasingMode="EaseOut"/>
        <QuadraticEase x:Key="SoftEase" EasingMode="EaseInOut"/>

        <Style x:Key="PoppingButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
        </Style>

        <!-- Icon buttons in the list toolbar -->
        <Style x:Key="ToolIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PoppingButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Circles, like the tray window's title-bar buttons. -->
                        <Border x:Name="Bg" Background="{DynamicResource SurfaceColor}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.12" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.12" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="0.9" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="0.9" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog buttons -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PoppingButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#E0453A" CornerRadius="18" Padding="18,10">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C93B31"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.06" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.06" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="0.94" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="0.94" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource PoppingButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource SurfaceColor}" CornerRadius="18" Padding="18,10">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="Medium" Foreground="{DynamicResource PrimaryText}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.06" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.06" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="0.94" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="0.94" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PoppingButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Pill geometry copied from the tray window's ActionButtonStyle. -->
                        <Border x:Name="Bg" Background="{DynamicResource NotesAccent}" CornerRadius="20" Padding="22,11">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe UI" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{DynamicResource NotesSelectionText}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.06" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.06" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="0.94" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="0.94" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A note row. The whole row lives in the ListBoxItem template so that IsSelected
             can recolour every line at once for contrast against the amber fill. -->
        <Style x:Key="NoteRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- The template has no ContentPresenter, so nothing inside it reaches the automation
                 tree. Name the row explicitly or a screen reader reads out the type name. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayTitle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- No selected fill of its own: a single travelling indicator behind the
                             rows carries the selection, the way the tab indicator does. -->
                        <Border x:Name="RowBg" Background="Transparent" CornerRadius="10"
                                Margin="6,2,6,2" Padding="12,9,12,10" Cursor="Hand">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RowTitle" Grid.Column="0" Text="{Binding DisplayTitle}"
                                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Path x:Name="PinGlyph" Grid.Column="1" Visibility="Collapsed"
                                          Data="M5,0.8 A2.1,2.1 0 1,1 5,5 A2.1,2.1 0 1,1 5,0.8 M5,5 V10.5"
                                          Stroke="{DynamicResource NotesAccent}" StrokeThickness="1.5"
                                          Fill="{DynamicResource NotesAccent}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Margin="6,1,0,0" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock x:Name="RowPreview" Text="{Binding Preview}"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" MaxHeight="34"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock x:Name="RowTime" Text="{Binding TimeLabel}"
                                           FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="PinGlyph" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowTitle" Property="Foreground" Value="{DynamicResource NotesSelectionText}"/>
                                <Setter TargetName="RowPreview" Property="Foreground" Value="{DynamicResource NotesSelectionSubtext}"/>
                                <Setter TargetName="RowTime" Property="Foreground" Value="{DynamicResource NotesSelectionSubtext}"/>
                                <Setter TargetName="PinGlyph" Property="Stroke" Value="{DynamicResource NotesSelectionText}"/>
                                <Setter TargetName="PinGlyph" Property="Fill" Value="{DynamicResource NotesSelectionText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim scrollbar. The stock WPF one is the only piece of unstyled Windows chrome that
             would otherwise appear inside the shell. Implicit, so it reaches the scroll viewers
             inside the ListBox and the editor. Vertical-only by design: this window disables
             horizontal scrolling in the list and wraps text in the editor. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBar" Width="5" CornerRadius="2.5"
                                                        HorizontalAlignment="Center" Opacity="0.4"
                                                        Background="{DynamicResource SecondaryText}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBar" Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBar" Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Formatting bar toggles: same circle as the tool buttons, amber when the caret sits in
             text that already has that formatting. -->
        <Style x:Key="FormatToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NotesSelectionFill}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NotesSelectionText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.12" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.12" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Picture viewer controls: always on a dark scrim whatever the theme is doing, so these
             use fixed translucent-white colours rather than theme brushes. -->
        <Style x:Key="ViewerButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="15"
                                MinWidth="30" Height="30" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1.1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1.1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             To="1" Duration="0:0:0.2"
                                                             EasingFunction="{StaticResource BubbleEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-width quiet row at the foot of the list card -->
        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterBg" Background="Transparent" CornerRadius="10"
                                Margin="6,4,6,6" Padding="12,9">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterBg" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PINNED / NOTES section headers, shown only when something is pinned -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <!-- 11px SemiBold secondary, the same as the tray window's AUTO-OFF / APPEARANCE labels. -->
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="16,12,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="280" MinWidth="200" MaxWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LIST PANE ===== -->
            <!-- A floating card on the same SurfaceColor as the tab strip, so the list reads as the
                 same kind of object rather than a wall bolted to the window edge. -->
            <Border x:Name="ListPane" Grid.Column="0" Background="{DynamicResource SurfaceColor}"
                    CornerRadius="14" Margin="14,2,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,2">
                        <Button x:Name="NewNoteButton" Click="NewNote_Click"
                                Style="{StaticResource ToolIconButtonStyle}" ToolTip="New note (Ctrl+N)">
                            <Path Data="M7,1.5 V12.5 M1.5,7 H12.5" Stroke="{DynamicResource NotesAccent}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="PinButton" Click="TogglePin_Click"
                                Style="{StaticResource ToolIconButtonStyle}" ToolTip="Pin or unpin">
                            <Path x:Name="PinButtonGlyph"
                                  Data="M6,1 A2.4,2.4 0 1,1 6,5.8 A2.4,2.4 0 1,1 6,1 M6,5.8 V12"
                                  Stroke="{DynamicResource PowerIconStroke}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <!-- Takes the pin's place while the bin is showing. -->
                        <Button x:Name="RestoreButton" Click="Restore_Click" Visibility="Collapsed"
                                Style="{StaticResource ToolIconButtonStyle}" ToolTip="Put this note back">
                            <Path Data="M7,11.5 V2.5 M3.5,6 L7,2.5 L10.5,6"
                                  Stroke="{DynamicResource NotesAccent}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="DeleteButton" Click="Delete_Click"
                                Style="{StaticResource ToolIconButtonStyle}" ToolTip="Delete note (Del)">
                            <Path Data="M1.5,3.5 H12.5 M5,3.5 V1.5 H9 V3.5 M3,3.5 V12.5 H11 V3.5 M5.8,6 V10 M8.2,6 V10"
                                  Stroke="{DynamicResource PowerIconStroke}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>

                    <!-- search -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHover}" CornerRadius="14"
                            Margin="12,4,12,8" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="13" Height="13" Margin="1,0,7,0" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.3"/>
                                <Line X1="9" Y1="9" X2="13" Y2="13"
                                      Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="SearchPlaceholder" Text="Search" FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged"
                                         FontFamily="Segoe UI" FontSize="12"
                                         Foreground="{DynamicResource PrimaryText}"
                                         CaretBrush="{DynamicResource PrimaryText}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- the list -->
                    <ListBox x:Name="NotesList" Grid.Row="2"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             PreviewMouseWheel="SmoothScroll_MouseWheel"
                             ItemContainerStyle="{StaticResource NoteRowStyle}"
                             SelectionChanged="NotesList_SelectionChanged">
                        <!-- Retemplated so the selection indicator can live inside the scrolled
                             content, next to the rows: it then scrolls with them for free. -->
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False" Padding="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid x:Name="RowSurface">
                                        <!-- RenderTransform is assigned from code: a Freezable
                                                 declared in a template is sealed and cannot be
                                                 animated. -->
                                        <Border x:Name="RowIndicator" Height="0" Opacity="0"
                                                Background="{DynamicResource NotesSelectionFill}"
                                                CornerRadius="10" Margin="6,0,6,0"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                                        <ItemsPresenter/>
                                    </Grid>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MenuPin" Header="Pin Note" Click="TogglePin_Click"/>
                                <MenuItem Header="Duplicate" Click="Duplicate_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete" Click="Delete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeaderStyle}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <TextBlock x:Name="NoResultsText" Grid.Row="2" Text="No matches"
                               FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed"/>

                    <!-- Recently Deleted lives at the foot of the card, the way Apple Notes keeps it
                         at the bottom of the sidebar. Doubles as the way back out. -->
                    <Button x:Name="BinButton" Grid.Row="3" Click="ToggleBin_Click"
                            Style="{StaticResource FooterButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="BinGlyph"
                                  Data="M1.5,3.5 H12.5 M5,3.5 V1.5 H9 V3.5 M3,3.5 V12.5 H11 V3.5"
                                  Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BinLabel" Text="Recently Deleted" Margin="9,0,0,0"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BinCount" Text="" Margin="6,0,0,0"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== DIVIDER ===== -->
            <GridSplitter Grid.Column="1" Width="9" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Panel.ZIndex="10" DragCompleted="Splitter_DragCompleted"/>

            <!-- ===== EDITOR ===== -->
            <!-- A card as well, mirroring the list. Both float on the window's ambience, which keeps
                 body text off the tinted background entirely. -->
            <Border x:Name="EditorPane" Grid.Column="2" Background="{DynamicResource NotesEditorBackground}"
                    CornerRadius="14" Margin="0,2,14,14">
                <Grid>
                    <!-- Date and text form one surface so switching notes can cross-fade the
                         whole thing, the way the tray window cross-fades its panels. -->
                    <Grid x:Name="EditorSurface" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="EditorScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header: the date sits centred, with the formatting toggle tucked to the
                             right so it costs no vertical space of its own. -->
                        <Grid Grid.Row="0" Margin="24,6,20,2">
                            <!-- The app's signature odometer text. Only the digits that actually
                                 change roll, so a save ticks the minute over rather than replacing
                                 the line. On a note switch the whole string rolls, but that happens
                                 underneath the editor's fade-in and so reads as one motion. -->
                            <local:ScrollingTextBlock x:Name="EditorDate" Text=""
                                                      TextFontSize="11" TextFontFamily="Segoe UI"
                                                      TextForeground="{DynamicResource SecondaryText}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      AnimationMilliseconds="200"/>
                            <ToggleButton x:Name="FormatToggle" Click="FormatToggle_Click"
                                          Style="{StaticResource FormatToggleStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0" ToolTip="Formatting">
                                <TextBlock Text="Aa" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/>
                            </ToggleButton>
                        </Grid>

                        <!-- Formatting bar: above the title, and folded away until asked for. The
                             host clips so the buttons slide out of sight rather than overhanging. -->
                        <Grid x:Name="FormatBarHost" Grid.Row="1" Height="0" Opacity="0" ClipToBounds="True">
                            <StackPanel x:Name="FormatBar" Orientation="Horizontal"
                                        VerticalAlignment="Top" Margin="24,0,24,0">
                            <ToggleButton x:Name="BoldButton" Click="Bold_Click"
                                          Style="{StaticResource FormatToggleStyle}" ToolTip="Bold (Ctrl+B)">
                                <TextBlock Text="B" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ItalicButton" Click="Italic_Click"
                                          Style="{StaticResource FormatToggleStyle}" ToolTip="Italic (Ctrl+I)">
                                <TextBlock Text="I" FontFamily="Segoe UI" FontSize="13" FontStyle="Italic"/>
                            </ToggleButton>
                            <ToggleButton x:Name="UnderlineButton" Click="Underline_Click"
                                          Style="{StaticResource FormatToggleStyle}" ToolTip="Underline (Ctrl+U)">
                                <TextBlock Text="U" FontFamily="Segoe UI" FontSize="13"
                                           TextDecorations="Underline"/>
                            </ToggleButton>
                            <ToggleButton x:Name="StrikeButton" Click="Strike_Click"
                                          Style="{StaticResource FormatToggleStyle}" ToolTip="Strikethrough">
                                <TextBlock Text="S" FontFamily="Segoe UI" FontSize="13"
                                           TextDecorations="Strikethrough"/>
                            </ToggleButton>

                            <Border Width="1" Margin="6,5,6,5" Background="{DynamicResource DividerColor}"/>

                            <ToggleButton x:Name="HeadingButton" Click="Heading_Click"
                                          Style="{StaticResource FormatToggleStyle}" ToolTip="Heading">
                                <TextBlock Text="H" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <ToggleButton x:Name="BulletsButton" Click="Bullets_Click"
                                          Style="{StaticResource FormatToggleStyle}" ToolTip="Bulleted list">
                                <TextBlock Text="•" FontFamily="Segoe UI" FontSize="17" Margin="0,-3,0,0"/>
                            </ToggleButton>
                            <ToggleButton x:Name="NumberingButton" Click="Numbering_Click"
                                          Style="{StaticResource FormatToggleStyle}" ToolTip="Numbered list">
                                <TextBlock Text="1." FontFamily="Segoe UI" FontSize="11"/>
                            </ToggleButton>

                            <Border Width="1" Margin="6,5,6,5" Background="{DynamicResource DividerColor}"/>

                            <Button x:Name="AttachButton" Click="AttachImage_Click"
                                    Style="{StaticResource ToolIconButtonStyle}"
                                    ToolTip="Add a picture — or just paste or drop one in">
                                <Path Data="M1.5,2.5 H12.5 V11.5 H1.5 Z M2.5,9.8 L5.6,6.2 L8,8.6 L9.6,7 L12.5,10.2 M4.6,5.1 A0.85,0.85 0 1,1 4.6,5.09"
                                      Stroke="{DynamicResource PowerIconStroke}" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Title: its own field, not the body's first line. -->
                        <Grid Grid.Row="2" Margin="28,2,28,0">
                            <TextBlock x:Name="TitlePlaceholder" Text="Title"
                                       FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryText}" Opacity="0.55"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="TitleBox" TextChanged="Title_TextChanged"
                                     PreviewKeyDown="Title_PreviewKeyDown"
                                     FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold"
                                     Foreground="{DynamicResource PrimaryText}"
                                     CaretBrush="{DynamicResource PrimaryText}"
                                     SelectionBrush="{DynamicResource NotesAccent}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     MaxLength="200"/>
                        </Grid>

                        <Border Grid.Row="3" Height="1" Margin="28,8,28,0"
                                Background="{DynamicResource DividerColor}"/>

                        <Grid Grid.Row="4">
                            <TextBlock x:Name="EditorPlaceholder" Text="Start typing…"
                                       FontFamily="Segoe UI" FontSize="14"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="30,8,0,0" VerticalAlignment="Top"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                            <RichTextBox x:Name="Editor" TextChanged="Editor_TextChanged"
                                         SelectionChanged="Editor_SelectionChanged"
                                         PreviewMouseWheel="SmoothScroll_MouseWheel"
                                         PreviewKeyDown="Editor_PreviewKeyDown"
                                         PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown"
                                         AllowDrop="True" PreviewDrop="Editor_PreviewDrop"
                                         PreviewDragOver="Editor_PreviewDragOver"
                                         FontFamily="Segoe UI" FontSize="14"
                                         Foreground="{DynamicResource PrimaryText}"
                                         CaretBrush="{DynamicResource PrimaryText}"
                                         SelectionBrush="{DynamicResource NotesAccent}"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="28,4,28,28"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         SpellCheck.IsEnabled="True"
                                         AcceptsTab="True">
                                <RichTextBox.Resources>
                                    <!-- FlowDocument puts a blank line between paragraphs by default. -->
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>
                        </Grid>
                    </Grid>

                    <!-- empty / nothing-selected state -->
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Path Data="M0,4 H34 M0,15 H26 M0,26 H20"
                              Stroke="{DynamicResource SecondaryText}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="34" Height="30" Opacity="0.35"
                              HorizontalAlignment="Center" Margin="0,0,0,18"/>
                        <TextBlock x:Name="EmptyStateTitle" Text="No Notes" FontFamily="Segoe UI" FontSize="19"
                                   FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="EmptyStateButton" Content="Create a note" Click="NewNote_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== SAVE ERROR TOAST ========== -->
        <!-- Floats over the content rather than occupying its own row, so it never squares off
             the shell's bottom corners. -->
        <Border x:Name="ErrorStrip" Background="#E0453A" CornerRadius="10"
                Padding="14,10" Margin="16,0,16,16" Panel.ZIndex="15"
                VerticalAlignment="Bottom" Visibility="Collapsed"
                RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ErrorSlide" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="16" Opacity="0.3"/>
            </Border.Effect>
            <TextBlock x:Name="ErrorText" Text="" FontFamily="Segoe UI" FontSize="12" Foreground="White"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ========== PICTURE VIEWER ========== -->
        <!-- Fills the whole notes surface, so maximising the popped-out window gives a genuinely
             full-screen view. Built as an overlay rather than a separate window for the same reason
             the delete confirmation is: it is the pattern this app already uses, and it stays inside
             the window that owns the note. -->
        <Grid x:Name="ViewerOverlay" Background="#F0121212" Visibility="Collapsed" Panel.ZIndex="30"
              Focusable="True">
            <ScrollViewer x:Name="ViewerScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          PreviewMouseWheel="Viewer_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="Viewer_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Viewer_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="Viewer_PreviewMouseLeftButtonUp">
                <Image x:Name="ViewerImage" Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="ViewerZoom" ScaleX="1" ScaleY="1"/>
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>

            <Button x:Name="ViewerCloseButton" Click="ViewerClose_Click"
                    Style="{StaticResource ViewerButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0"
                    ToolTip="Close (Esc)">
                <TextBlock Text="✕" FontSize="13"/>
            </Button>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                    Background="#33FFFFFF" CornerRadius="19" Padding="4">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="16" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ZoomOutButton" Click="ZoomOut_Click"
                            Style="{StaticResource ViewerButtonStyle}" ToolTip="Zoom out (−)">
                        <TextBlock Text="−" FontSize="16"/>
                    </Button>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="White"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="Medium"
                               MinWidth="52" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="ZoomInButton" Click="ZoomIn_Click"
                            Style="{StaticResource ViewerButtonStyle}" ToolTip="Zoom in (+)">
                        <TextBlock Text="+" FontSize="16"/>
                    </Button>

                    <Border Width="1" Margin="6,7,6,7" Background="#33FFFFFF"/>

                    <Button x:Name="FitButton" Click="ViewerFit_Click"
                            Style="{StaticResource ViewerButtonStyle}" ToolTip="Fit (0)">
                        <TextBlock Text="Fit"/>
                    </Button>
                    <Button x:Name="ActualSizeButton" Click="ViewerActualSize_Click"
                            Style="{StaticResource ViewerButtonStyle}" ToolTip="Actual size (1)">
                        <TextBlock Text="1:1"/>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ViewerSizeLabel" Text="" Foreground="#8CFFFFFF"
                       FontFamily="Segoe UI" FontSize="11"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,32"/>
        </Grid>

        <!-- ========== DELETE CONFIRMATION ========== -->
        <Grid x:Name="ConfirmOverlay"
              Background="{DynamicResource NotesScrim}" Visibility="Collapsed" Panel.ZIndex="20">
            <Border Background="{DynamicResource WindowBackground}" CornerRadius="12"
                    Padding="26,22" MaxWidth="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ConfirmScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="24" Opacity="0.28"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" Text="Delete note?" FontFamily="Segoe UI" FontSize="15"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="This cannot be undone." FontFamily="Segoe UI" FontSize="12"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center" Margin="0,7,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Cancel" Click="ConfirmCancel_Click"
                                Style="{StaticResource QuietButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Delete" Click="ConfirmDelete_Click"
                                Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
